{
  "name": "volantines-reto",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "vitest run",
    "typecheck": "tsc -p shared --noEmit && tsc -p client --noEmit && tsc -p server --noEmit",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "start": "npm run build && npm run start -w server",
    "db": "docker compose up -d"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
